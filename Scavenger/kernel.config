# Kernel config fragment for Scavenger (NVMe CMB uninitialized-free trigger)
# Applied after default.config.
#
# /dev/mem access: required for reading/writing NVMe CMB MMIO region.
# NVMe driver: must be built-in (not module) so the guest can use NVMe
#   CMB (Controller Memory Buffer) for DMA operations — the CMB code
#   path is the trigger for the uninitialized QEMUSGList free.
# virtio-gpu: used in the full VM escape chain (ROP pivot target for
#   function pointer overwrite via QEMUTimer).

CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n

CONFIG_BLK_DEV_NVME=y
CONFIG_DRM_VIRTIO_GPU=y
