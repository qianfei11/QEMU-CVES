# Kernel build artefacts
**/*.ko
**/*.o
**/.*.cmd
**/.tmp_versions/
**/modules.order
**/Module.symvers

# Runtime shared library deps copied alongside QEMU binary
**/*.so
**/*.so.*

# Temporary debug binaries in rootfs
**/rootfs/pcidbg

# Claude Code session data (local only)
.claude/projects/
.claude/settings.local.json
