# Default kernel configuration fragment for QEMU-CVES reproductions
# Applied on top of x86_64_defconfig for every CVE build.
#
# Usage (in build.sh):
#   make -C "$LINUX_SRC" O="$LINUX_BUILD" x86_64_defconfig
#   apply_kconfig_fragment "$ROOT_DIR/default.config" "$LINUX_BUILD/.config"
#   [apply_kconfig_fragment "$SCRIPT_DIR/kernel.config" "$LINUX_BUILD/.config"]
#   make -C "$LINUX_SRC" O="$LINUX_BUILD" olddefconfig

# Serial console — required for kernel messages and interactive shell
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Initial RAM disk — required for busybox initramfs boot
CONFIG_BLK_DEV_INITRD=y

# Stack unwinder — use frame-pointer unwinder for legible GDB backtraces
# (ORC unwinder strips frame pointers and complicates debugger sessions)
CONFIG_UNWINDER_ORC=n
CONFIG_UNWINDER_FRAME_POINTER=y

# Modern GCC compatibility for older Linux 5.4.x repro kernels
CONFIG_RETPOLINE=n
CONFIG_STACK_VALIDATION=n
